#!/bin/bash

# Build the custom system image into bin/. Takes a while (10-60 min), but
# afterwards bin/run_julia starts with the heavy dependencies preloaded.
#
# Note: julia is started with the *default* system image here, so that the
# image being written is not the one currently in use.

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

export KMP_DUPLICATE_LIB_OK="TRUE"

julia -t auto --startup-file=no test/create_sys_image.jl

# ModelingToolkit and InductionMachineDrives are not baked into the image, so
# their precompile caches have to be (re)built against it once -- otherwise the
# first script that uses them pays for it interactively. Loading MTK together
# with the package also rebuilds the InductionMachineDrivesMTKExt cache, which
# is what the menu2() scripts wait for.
for sysimage in bin/sysimage.so bin/sysimage.dylib bin/sysimage.dll; do
    if [[ -f $sysimage ]]; then
        echo "Precompiling InductionMachineDrives and ModelingToolkit against $sysimage ..."
        julia -t auto --startup-file=no --project=scripts -J "$sysimage" \
            -e 'using OrdinaryDiffEq, ModelingToolkit, InductionMachineDrives'
        break
    fi
done
